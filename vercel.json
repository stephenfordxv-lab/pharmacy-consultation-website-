{
  "version": 2,
  "builds": [
    {
      "src": "next.config.js",
      "use": "@vercel/next"
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "/" }],
  "env": {
    "NEXTAUTH_URL": "https://pharmacy-consultation-website-<your-domain>.vercel.app"
  },
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs18.x"
    }
  },
  "nodeVersion": "18.x"
}
